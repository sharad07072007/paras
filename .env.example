# ==============================================================================
# Google Cloud Firestore Configuration (Permanent Database Storage)
# ==============================================================================
# Choose one of the following methods to authenticate with Google Cloud Firestore:
#
# METHOD 1: Service Account JSON file (Ideal for local development)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#
# METHOD 2: Service Account JSON string in environment (Ideal for Vercel / Render / Cloud)
# Paste the full contents of your service-account.json here as a single-line string:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com"}
#
# METHOD 3: Individual Environment Variables
GCP_PROJECT_ID=clinic-info-512007
FIRESTORE_DATABASE_ID=my-clinic-db
# GCP_CLIENT_EMAIL=clinic-details@clinic-info-512007.iam.gserviceaccount.com
# GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
#
# METHOD 4: Local Firestore Emulator (Optional for offline testing)
# FIRESTORE_EMULATOR_HOST=localhost:8080

